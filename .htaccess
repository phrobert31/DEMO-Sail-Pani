# Sail&Clean: Apache settings for Aruba hosting (ignored by GitHub Pages).
# Generated by tools/build.js / tools/set-domain.py from site.config.json.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddType image/webp .webp
AddType text/plain .txt
AddType application/xml .xml

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical host (www.sailandclean.it): www and non-www go to the same address
  RewriteCond %{HTTP_HOST} !^www\.sailandclean\.it$ [NC]
  RewriteRule ^ https://www.sailandclean.it%{REQUEST_URI} [L,R=301]

  # Never publish the source and tooling folders if they get uploaded by mistake
  RewriteRule ^(src|tools|docs|node_modules|\.claude|\.github)(/|$) - [F,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
